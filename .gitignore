# Build outputs (large, regeneratable via ./build.sh)
dist/
*.flatpak
!Dockerfile.flatpak

# Docker / flatpak working dirs + caches
.work/
# persistent Slack source-package cache (survives across builds)
.cache/
.npm-cache/
# flatpak stage input/output dir (manifest, payload, .flatpak)
.fp/
.flatpak/
.flatpak-cache/
# flatpak user-install state: caches the aarch64 runtime across builds
.flatpak-user/

# local configuration (contains machine-specific paths)
.env

# editor / OS noise
.DS_Store
