# ============================================================================
# Slack Desktop aarch64 Flatpak build — configuration
#
# Copy this file to `.env` and edit. Every value can also be set as a normal
# environment variable. (build.sh sources .env with `set -a`, so .env wins over
# a pre-set env var — to force a value, edit .env.)
#
# The output is a self-contained aarch64 .flatpak bundle (in ./dist/) — the sole
# deliverable. Slack already ships x86_64; this is the aarch64 complement.
# The build runs entirely inside Docker, so the host stays clean. It works on any
# Docker host — aarch64 is recommended (fastest); x86_64 cross-builds via QEMU
# (BUILD_PLATFORM=linux/arm64), fully supported, just a bit slower.
# ============================================================================

# Slack version to build (used for output naming + the CDN download path).
# This is the FULL version (e.g. 4.53.276). Slack ships stable + beta channels;
# check https://slack.com/intl/en-us/download/desktop/ (or the Arch AUR
# slack-desktop PKGBUILD) for the latest.
SLACK_VERSION=4.53.276

# ---------------------------------------------------------------------------
# Slack source (pick ONE — the CDN download works out of the box)
# ---------------------------------------------------------------------------
# Default: the build downloads the official amd64 .deb straight from Slack's CDN
# (downloads.slack-edge.com/desktop-releases/linux/x64/<ver>/...). Just set
# SLACK_VERSION above and run ./build.sh.
#
# Alternative: a local official Slack package (amd64 .deb or x86_64 .rpm), which
# takes precedence over the download — handy for pinning or air-gapped builds:
# SLACK_SOURCE_FILE=$HOME/Downloads/slack-desktop-4.53.276-amd64.deb
#
# Or an explicit download URL (used only if SLACK_SOURCE_FILE is empty):
# SLACK_SOURCE_URL=https://downloads.slack-edge.com/desktop-releases/linux/x64/4.53.276/slack-desktop-4.53.276-amd64.deb
SLACK_SOURCE_FILE=
SLACK_SOURCE_URL=

# Where the downloaded Slack package is cached (keyed by version) so repeat
# builds don't re-download it. Defaults to <repo>/.cache (git-ignored). Leave
# unset for the default. (CI runners clear the workspace, so this is a no-op
# there.)
SLACK_CACHE_DIR=

# ---------------------------------------------------------------------------
# Native module versions (defaults are the proven values for Slack 4.50.143)
# ---------------------------------------------------------------------------
# electron-native-auth + file-handler-info + slack-desktop-utils versions are
# AUTO-DETECTED from app.asar at build time (see native/02-detect-versions.sh).
# Only the public `native-keymap` fork needs a pin (its npm versioning differs
# from Slack's private @tinyspeck/native-keymap). `latest` is a valid dist-tag.
NATIVE_KEYMAP_VERSION=2.5.0

# ---------------------------------------------------------------------------
# Flatpak output
# ---------------------------------------------------------------------------
# App id. `com.slack.Slack` is the canonical id (Slack's official build is
# x86_64, so there is no aarch64 official to collide with). Use
# `com.slack.Slack.aarch64` if you prefer a distinct id.
SLACK_APP_ID=com.slack.Slack

# Base runtime. org.gnome.Platform provides every library Slack links against
# (GTK3, GLib, ATK/atspi, Cairo/Pango, X11, GBM, xkbcommon, udev, ALSA, NSS,
# CUPS, DBus, libsecret, libnotify, libpulse, GStreamer) with ZERO build modules.
# Version = the GNOME Platform branch; Flathub serves it for aarch64 (e.g. 51).
# The SDK (org.gnome.Sdk) is the matching build base flatpak-builder installs
# against; keep it on the same branch as the runtime.
FLATPAK_RUNTIME=org.gnome.Platform
FLATPAK_RUNTIME_VERSION=51
FLATPAK_SDK=org.gnome.Sdk

# Target architecture (the whole point: aarch64).
FLATPAK_ARCH=aarch64

# Remote that hosts the base runtime (Flathub mirrors org.gnome.Platform).
FLATPAK_REMOTE_URL=https://dl.flathub.org/repo/flathub.flatpakrepo
FLATPAK_RUNTIME_REPO=https://dl.flathub.org/repo/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# Pin base images to FULL version tags (Debian 13 "trixie") for reproducible
# builds — no floating channel tags. For an even stronger guarantee, pin by
# digest instead: image@sha256:....
# (arm64 variants are pulled automatically on an aarch64 host; on x86_64 the
#  native stage builds arm64 via QEMU.)
NATIVE_BASE_IMAGE=node:24.22.2-trixie
FLATPAK_BASE_IMAGE=debian:13.7
# Leave empty to auto-detect the host arch (aarch64 builds natively; x86_64
# cross-builds aarch64 via QEMU). Set it (e.g. linux/arm64) to force a target.
BUILD_PLATFORM=
# Extra `docker run` flags for the flatpak stage (flatpak-builder's bubblewrap
# sandbox needs unprivileged user namespaces / relaxed seccomp in a container).
# Double-quoted: build.sh word-splits this into individual docker flags.
FLATPAK_DOCKER_FLAGS="--security-opt seccomp=unconfined --cap-add SYS_ADMIN"
